    <child link="wrist_1_link"/>
    <origin xyz="0 -0.01080 0.17780" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-3.14" upper="3.14" effort="5.0" velocity="1.0"/>
